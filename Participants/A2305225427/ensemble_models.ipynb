import os
import random
import numpy as np
import torch
import torch.nn as nn
from torch.utils.data import DataLoader
from torchvision import models, transforms
from torchvision.datasets import ImageFolder
from sklearn.linear_model import LogisticRegression
from sklearn.svm import SVC
from sklearn.ensemble import RandomForestClassifier, VotingClassifier
from sklearn.metrics import accuracy_score, classification_report
from sklearn.model_selection import train_test_split
from tqdm import tqdm
from PIL import Image
from pathlib import Path
import matplotlib.pyplot as plt
import seaborn as sns
import shutil

SEED = 42
BATCH_SIZE = 128
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

SOURCE_DATASET_PATH = "/kaggle/input/spacenet-an-optimally-distributed-astronomy-data/SpaceNet.FLARE.imam_alam"
OUTPUT_DATASET_PATH = "/kaggle/working/dataset"

print(f"Running on device: {DEVICE}")

def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = True

set_seed(SEED)

def prepare_dataset(src, dst, train_ratio=0.7, test_ratio=0.3):
    if os.path.exists(dst):
        print("Processed dataset already exists. Skipping splitting.")
        return

    print("Preparing dataset split...")

    classes = [d for d in os.listdir(src) if os.path.isdir(os.path.join(src, d))]

    for split in ["train", "test"]:
        for cls in classes:
            os.makedirs(os.path.join(dst, split, cls), exist_ok=True)

    for cls in classes:
        img_dir = os.path.join(src, cls)
        images = os.listdir(img_dir)
        random.shuffle(images)

        split_idx = int(len(images) * train_ratio)
        train_imgs = images[:split_idx]
        test_imgs = images[split_idx:]

        for img in train_imgs:
            shutil.copy(os.path.join(img_dir, img),
                        os.path.join(dst, "train", cls, img))

        for img in test_imgs:
            shutil.copy(os.path.join(img_dir, img),
                        os.path.join(dst, "test", cls, img))

    print("Dataset successfully prepared.")

prepare_dataset(SOURCE_DATASET_PATH, OUTPUT_DATASET_PATH)

transform = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])

train_ds = ImageFolder(os.path.join(OUTPUT_DATASET_PATH, "train"), transform=transform)
test_ds  = ImageFolder(os.path.join(OUTPUT_DATASET_PATH, "test"), transform=transform)

train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4, pin_memory=True)
test_loader  = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=4, pin_memory=True)

class_names = train_ds.classes

print("Classes:", class_names)
print(f"Train Samples: {len(train_ds)}, Test Samples: {len(test_ds)}")

weights = models.ResNet50_Weights.IMAGENET1K_V1
resnet = models.resnet50(weights=weights)
resnet.fc = nn.Identity()
resnet = resnet.to(DEVICE)
resnet.eval()

@torch.no_grad()
def extract_features(loader, model):
    features, labels = [], []

    for imgs, lbls in tqdm(loader, desc="Extracting Embeddings"):
        imgs = imgs.to(DEVICE)
        outputs = model(imgs)
        outputs = outputs.flatten(start_dim=1)

        features.append(outputs.cpu().numpy())
        labels.append(lbls.numpy())

    return np.vstack(features), np.concatenate(labels)

print("Extracting training features...")
X_train, y_train = extract_features(train_loader, resnet)

print("Extracting testing features...")
X_test, y_test = extract_features(test_loader, resnet)

print("Train feature shape:", X_train.shape)
print("Test feature shape :", X_test.shape)

log_reg = LogisticRegression(max_iter=1200, random_state=SEED, n_jobs=-1)
svm = SVC(kernel="rbf", probability=True, random_state=SEED)
rf = RandomForestClassifier(n_estimators=120, random_state=SEED)

ensemble = VotingClassifier(
    estimators=[
        ("lr", log_reg),
        ("svm", svm),
        ("rf", rf)
    ],
    voting="soft"
)

models_dict = {
    "Logistic Regression": log_reg,
    "Support Vector Machine": svm,
    "Random Forest": rf,
    "Soft Voting Ensemble": ensemble
}

results = {}

print("\nTraining models...\n")
for name, model in models_dict.items():
    print(f"Training {name}...")
    model.fit(X_train, y_train)

    preds = model.predict(X_test)
    acc = accuracy_score(y_test, preds)
    results[name] = acc

    print(f"{name} Accuracy: {acc:.4f}")
    print("-" * 35)

sns.set_theme(style="whitegrid", context="talk")

plt.figure(figsize=(11,6))
bars = sns.barplot(x=list(results.keys()), y=list(results.values()), palette="viridis")

plt.title("Model Accuracy Comparison")
plt.ylabel("Accuracy")
plt.xlabel("Model")
plt.ylim(0,1)

for bar, val in zip(bars.patches, results.values()):
    plt.text(bar.get_x()+bar.get_width()/2, val+0.015, f"{val*100:.2f}%",
             ha="center", fontsize=12, weight="bold")

plt.xticks(rotation=12)
plt.tight_layout()
plt.show()

final_preds = ensemble.predict(X_test)

print("Classification Report for Ensemble:\n")
print(classification_report(y_test, final_preds, target_names=class_names))
